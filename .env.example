# Copy to .env and fill in real values. Never commit the real .env file.

# --- App ---
APP_ENV=local
APP_NAME=AgriGuardian
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database (asyncpg DSN used by the API at runtime) ---
DATABASE_URL=postgresql+asyncpg://agri_guardian:agri_guardian@postgres:5432/agri_guardian
# Sync DSN used only by Alembic migrations (psycopg driver).
DATABASE_URL_SYNC=postgresql+psycopg://agri_guardian:agri_guardian@postgres:5432/agri_guardian

POSTGRES_USER=agri_guardian
POSTGRES_PASSWORD=agri_guardian
POSTGRES_DB=agri_guardian

# --- Redis (cache, Celery broker/backend, rate limits, locks) ---
REDIS_URL=redis://redis:6379/0

# --- Auth (Firebase by default; legacy Supabase settings used only when
# AUTH_PROVIDER=supabase is selected explicitly) ---
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
AUTH_PROVIDER=firebase

# Firebase email OTP authentication (server only; never place the service
# account or OTP secret in Flutter or source control).
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
OTP_HMAC_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- Object storage (photos, GeoTIFFs; DB stores only the key/metadata) ---
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET=agri-guardian-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto

# --- External integrations (left unset on purpose; clients fail closed, no fake data) ---
NASA_EARTHDATA_TOKEN=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
WEATHER_PROVIDER_API_KEY=
AI_INFERENCE_ENDPOINT=
AI_INFERENCE_API_KEY=

# --- NASA POWER (open data API, no key required - a different access path
# from NASA_EARTHDATA_TOKEN above, which this endpoint does not need) ---
NASA_POWER_BASE_URL=https://power.larc.nasa.gov
NASA_POWER_TIMEOUT_SECONDS=30
# Explicit and deterministic: true means zero NASA network calls, ever;
# the advisory service then falls back to cache/committed fixtures only.
NASA_POWER_OFFLINE=false
NASA_POWER_CACHE_DIR=cache/nasa_power
NASA_POWER_FIXTURE_DIR=tests/fixtures/nasa_power

# --- Data-provider integrations (backend/api/app/integrations; see registry.py) ---
# Most work with no key. Credentialed ones fail closed with a clear error when unset.
# Global kill switch: true = no integration client may touch the network.
INTEGRATIONS_OFFLINE=false
# AppEEARS tasks (NASA Earthdata login; Harmony/GES DISC use NASA_EARTHDATA_TOKEN above)
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
# Sentinel Hub / openEO / CDSE downloads use COPERNICUS_CLIENT_ID/SECRET above
# (an OAuth client created in the Copernicus Data Space dashboard).
# Free key from opentopography.org - needed for DEM/slope.
OPENTOPOGRAPHY_API_KEY=
# FAOSTAT query API now needs a token; the keyless bulk-file path works without it.
FAOSTAT_TOKEN=
# Earth Engine: GCP project + service-account key file (also needs `pip install google-auth`).
GEE_PROJECT=
GEE_SERVICE_ACCOUNT_FILE=
# Open-Meteo is free for non-commercial use; set a key (and customer- URLs) for commercial.
OPEN_METEO_API_KEY=

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
